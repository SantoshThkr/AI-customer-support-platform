# Copy to .env and adjust. Used by docker compose.

POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support

# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional. Without a key the app runs normally and AI features are disabled.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUESTS_PER_MINUTE=20

ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432
